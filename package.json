{
  "name": "dawahnigeria-next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web frontend for dawahnigeria.com — discovering and listening to Islamic lectures.",
  "license": "Apache-2.0",
  "homepage": "https://dawahnigeria.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawahanigeria-team/dawahnigeria-next.git"
  },
  "bugs": {
    "url": "https://github.com/dawahanigeria-team/dawahnigeria-next/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@react-oauth/google": "^0.13.5",
    "@sentry/nextjs": "^10.73.0",
    "next": "^16.3.5",
    "posthog-js": "^1.430.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0"
}
