# Loaded by `next dev` only. .env.local still wins over this file, so keep
# environment-specific values here rather than there.
#
# ⚠ THIS FILE IS COMMITTED. Never put a secret here — no auth tokens, no database
# URIs, no API keys. It holds only values that are already public by necessity:
# URLs the browser calls and the tenant id sent as the `x-project` header on
# every client request. Anything genuinely secret belongs in .env.local, which is
# gitignored and takes precedence over everything in this file.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Required by src/lib/env.ts, which validates at module scope — a missing value
# here fails the *build*, not just the request. Committed so a fresh clone runs
# `pnpm dev` with no setup step. Point these at your own API by overriding them
# in .env.local rather than editing this file.
API_BASE_URL=https://api.dawahnigeria.com/api
API_ADMINISTER_BASE_URL=https://api.dawahnigeria.com/administer/api
API_PROJECT_ID=206cf92c-8a46-45ef-bf3f-a6ef92fc6f25
