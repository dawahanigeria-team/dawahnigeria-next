{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dn-dawahcast-next",
  // Wraps .open-next/worker.js to run the session refresh ported from proxy.ts.
  "main": "custom-worker.ts",
  // Newest date the installed workerd supports; bump alongside wrangler.
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Exposes the deployed version id, which scopes the Worker's HTML cache in
  // src/lib/htmlCache.ts. That cache outlives a deploy but the asset set does
  // not, so without this an entry from an earlier build gets served with dead
  // chunk hashes and the page renders unstyled.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  // Serve the production apex and www host from this Worker. The custom Worker
  // permanently redirects www to the apex so crawlers see one canonical host.
  // `custom_domain` makes Wrangler create and manage the DNS records.
  //
  // beta.dawahnigeria.com was removed once the app went live on the apex — it
  // existed only as the staging host during the CRA migration. `workers_dev`
  // below is the remaining pre-DNS smoke-test URL, and unlike beta it is not on
  // the public domain, so there is no second copy of the catalogue to keep out
  // of the index.
  "routes": [
    {
      "pattern": "dawahnigeria.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dawahnigeria.com",
      "custom_domain": true
    }
  ],

  // Declaring `routes` turns the workers.dev URL off by default. Keep it on:
  // it is the fallback for testing when DNS or the zone is mid-change.
  "workers_dev": true,

  // custom-worker.ts runs before the Next server, so it cannot read the .env
  // files OpenNext compiles into the bundle — these two have to reach it via
  // the Worker env. The Next server keeps reading its own copies from .env.
  "vars": {
    "API_BASE_URL": "https://api.dawahnigeria.com/api",
    "API_PROJECT_ID": "206cf92c-8a46-45ef-bf3f-a6ef92fc6f25"
  },

  // No `images` binding on purpose. `unoptimized: true` in next.config.mjs
  // means /_next/image is never requested, so nothing needs one -- and leaving
  // the binding off is what makes the $0 guarantee structural rather than a
  // setting someone can quietly flip back. Cloudflare Images is metered per
  // unique transformation with no hard spend cap. It added $5 to the invoice
  // issued September 11, alongside R2 writes and Workers CPU overage.

  // No R2/KV/D1/service/DO cache bindings. Disposable public API data and HTML
  // are cached by the Cache API; build-time prerenders ship as static assets.
  // Retain the historical migration/export for safe deployment and rollback;
  // no runtime binding calls the old revalidation queue.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ]

  // Public data now expires by TTL, not revalidateTag. Do not add a paid tag
  // store or cache binding without reviewing the billing implications.
}
