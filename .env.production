# Loaded by production builds (and by the Worker, which OpenNext compiles these
# into as the `production` map in .open-next/cloudflare/next-env.mjs).
#
# ⚠ THIS FILE IS COMMITTED. Never put a secret here — no auth tokens, no database
# URIs, no API keys. It holds only values that are already public by necessity:
# URLs the browser calls and the tenant id sent as the `x-project` header on
# every client request. Anything genuinely secret belongs in .env.local
# (gitignored) for local work, and in Cloudflare Worker secrets for production.
# A Sentry DSN only lets a client *send* events, which is why every browser
# bundle carries one; it is not a secret. Errors only: tracing, Session Replay
# and profiling stay off until their quota cost has been looked at.
NEXT_PUBLIC_SENTRY_DSN=https://2b5d221b09b8cf6d471f22d042f39e65@o980827.ingest.us.sentry.io/4511944881537029
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# PostHog's project token is a public, write-only browser key. Next.js inlines
# NEXT_PUBLIC_* values while building, so keeping these in the tracked
# production environment makes Cloudflare Workers Builds configure analytics
# reliably without duplicating them as runtime Worker variables.
NEXT_PUBLIC_POSTHOG_KEY=phc_venP2RoMbc5IQ7t47EDQDbkPKp120AuADuFHIrWIYeX
NEXT_PUBLIC_POSTHOG_HOST=https://t.dawahnigeria.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Required by src/lib/env.ts, which validates at module scope — a missing value
# here fails the *build*, not just the request. Committed so that the build works
# with no dashboard configuration at all: Cloudflare Workers Builds, GitHub CI,
# contributor forks and fresh clones all get them identically.
API_BASE_URL=https://api.dawahnigeria.com/api
API_ADMINISTER_BASE_URL=https://api.dawahnigeria.com/administer/api
API_PROJECT_ID=206cf92c-8a46-45ef-bf3f-a6ef92fc6f25
