# Server-only (do not prefix with NEXT_PUBLIC_)
# API_BASE_URL and API_PROJECT_ID are also mirrored into wrangler.jsonc `vars`:
# custom-worker.ts refreshes sessions before the Next server boots, so it reads
# them off the Cloudflare env rather than these files. Change both together.
API_BASE_URL=https://api.dawahnigeria.com/api
API_ADMINISTER_BASE_URL=https://api.dawahnigeria.com/administer/api
API_PROJECT_ID=206cf92c-8a46-45ef-bf3f-a6ef92fc6f25

# Public site origin (used in metadata + OG tags)
NEXT_PUBLIC_SITE_URL=https://dawahnigeria.com

# Google OAuth client for the sign-in button. A client id is not a secret; the
# production one is hardcoded as a fallback in features/auth/GoogleButton.tsx, so
# leave this unset unless you are pointing at your own OAuth client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── PostHog ─────────────────────────────────────────────────────────────────
# Both left blank disables analytics entirely (no network calls, no-op captures).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Sentry ──────────────────────────────────────────────────────────────────
# Browser: public DSN, shipped in the client bundle.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Server: falls back to the public DSN when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Source-map upload at build time (set these in CI only).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Tawk.to chat ────────────────────────────────────────────────────────────
# Set to "false" to disable the widget. Any other value (or unset) enables it,
# subject to the DNT / GPC / storage checks in features/chat/tawk.ts.
NEXT_PUBLIC_ENABLE_TAWK=
